# Supabase project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only: used by `npm run seed`. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server only: enables the AI copilot / analyst (/api/ai)
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5)
# SF_AI_MODEL=claude-opus-5-5

# ---------------------------------------------------------------------------
# Data connections (server only). Same names as the GitHub repository secrets.
# Leave any blank to turn that connection off. Check them: npm run providers:check
# ---------------------------------------------------------------------------
# Direct Postgres connection string (Supabase → Project Settings → Database)
DATABASE_URL=
# African markets, economics, FX, trade — https://africa-api.com
AFRICA_API_KEY=
# Global quotes, history, FX, fundamentals, economics — https://www.alphavantage.co
ALPHAVANTAGE_API_KEY=
# UK company registry — https://developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=
# News — https://currentsapi.services
CURRENTS_API_KEY=
# Global EOD/intraday prices, fundamentals, calendars — https://eodhd.com
EODHD_API_KEY=
# FX rates — https://www.exchangerate-api.com
EXCHANGERATE_API_KEY=
# Quotes, statements, ratios, estimates — https://financialmodelingprep.com
FMP_API_KEY=
# US & international economic series — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# African stock exchanges — https://mansaapi.com
MANSA_API_KEY=
# Financial news with entity sentiment — https://www.marketaux.com
MARKETAUX_API_KEY=
# Global EOD/intraday prices — https://marketstack.com
MARKETSTACK_API_KEY=
# African exchanges, partner API (pk_live_… or sk_sandbox_…) — https://mystocks.africa/partners
MYSTOCKS_AFRICA_API_KEY=
# News and events (Event Registry) — https://newsapi.ai
NEWSAPI_AI_KEY=
# Nigerian Exchange + NASD OTC — https://ngxpulse.ng/api
NGX_PULSE_API_KEY=
# Optional base-URL overrides for the newer African APIs, if a provider moves hosts:
# AFRICA_API_BASE_URL=https://api.africa-api.com
# MANSA_API_BASE_URL=https://www.mansaapi.com
# MYSTOCKS_AFRICA_BASE_URL=https://mystocks.africa/api/v1/partner
# NGX_PULSE_BASE_URL=https://ngxpulse.ng/api

# ---------------------------------------------------------------------------
# Live market data sync (/api/cron/market-sync, npm run market:sync)
# ---------------------------------------------------------------------------
# Protects the cron endpoint. Vercel Cron sends it automatically when set in the project.
CRON_SECRET=
# The sync writes prices with SUPABASE_SERVICE_ROLE_KEY (above) or, if that is unset, DATABASE_URL.
# Optional tuning:
# MARKET_HISTORY_DAYS=400          # days of daily history kept per instrument
# MARKET_HISTORY_BUDGET=25         # history backfills per run from EODHD / FMP / Marketstack
# MARKET_ALPHAVANTAGE_BUDGET=20    # Alpha Vantage calls per run (free keys: 25 a day)
